rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuários
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Consultas (appointments): leitura e escrita
    // Nota: O app usa auth customizado (localStorage). Para produção com Firebase Auth,
    // altere para: allow read, write: if request.auth != null;
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }
  }
}
