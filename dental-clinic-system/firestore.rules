rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuários: apenas o próprio usuário autenticado pode ler/escrever
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Agendamentos: acesso público temporário (app usa auth customizado via localStorage)
    // IMPORTANTE: migrar para Firebase Auth e alterar para:
    // allow read, write: if request.auth != null;
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['patientId', 'professionalId', 'date', 'startTime', 'endTime', 'type', 'status', 'createdBy'])
                   && request.resource.data.patientId is string
                   && request.resource.data.professionalId is string
                   && request.resource.data.date is string
                   && request.resource.data.startTime is string
                   && request.resource.data.endTime is string
                   && request.resource.data.type is string;
      allow update: if resource != null;
      allow delete: if resource != null;
    }
  }
}
